+package com.checkyoursenior.guardian.service
+
+import android.Manifest
+import android.app.Application
+import android.app.NotificationManager
+import android.content.pm.PackageManager
+import com.checkyoursenior.contract.Cancellable
+import com.checkyoursenior.contract.DispatchChannel
+import com.checkyoursenior.contract.DispatchResult
+import com.checkyoursenior.contract.DispatchTarget
+import com.checkyoursenior.contract.IncidentSnapshot
+import com.checkyoursenior.contract.Scheduler
+import com.checkyoursenior.contract.VitalsSnapshot
+import com.checkyoursenior.guardian.emergency.dispatch.AlertKind
+import com.checkyoursenior.guardian.emergency.dispatch.AndroidAlertMessages
+import com.checkyoursenior.guardian.emergency.dispatch.AndroidAlertNotifier
+import com.checkyoursenior.guardian.emergency.dispatch.AndroidSmsSender
