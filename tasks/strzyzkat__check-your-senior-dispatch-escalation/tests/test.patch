+
+        assertEquals(setOf(MonitorDetail.NO_VITALS_SOURCE), causes(VitalsAvailability.NOT_INSTALLED))
+        assertEquals(setOf(MonitorDetail.NO_VITALS_SOURCE), causes(VitalsAvailability.UPDATE_REQUIRED))
