+        val threads = mutableListOf<Thread>()
+
+        runBlocking {
+            val job = alertScope.launchRecording(threads)
+            job.join()
+        }
+
+        assertTrue("the alert path ran on the caller's thread", threads.single() != Thread.currentThread())
+    }
+
+    @Test
+    fun `a failing child does not cancel the scope the retraction will need`() {
+        val alertScope = IncidentModule.alertScope()
