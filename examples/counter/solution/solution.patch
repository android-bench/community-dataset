+        super.onCreate(savedInstanceState)
+        enableEdgeToEdge()
+        setContent {
+            MaterialTheme {
+                CounterScreen()
+            }
+        }
+    }
+}
diff --git a/app/src/test/java/com/example/counter/CounterViewModelTest.kt b/app/src/test/java/com/example/counter/CounterViewModelTest.kt
new file mode 100644
index 0000000..3fd421a
--- /dev/null
+++ b/app/src/test/java/com/example/counter/CounterViewModelTest.kt
@@ -0,0 +1,37 @@
+package com.example.counter
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class CounterViewModelTest {
+
+    @Test
+    fun initialState_isZero() {
+        val viewModel = CounterViewModel()
+        assertEquals(0, viewModel.count.value)
+    }
+
+    @Test
+    fun increment_increasesCount() {
+        val viewModel = CounterViewModel()
+        viewModel.increment()
+        assertEquals(1, viewModel.count.value)
+    }
+
+    @Test
+    fun decrement_decreasesCount() {
+        val viewModel = CounterViewModel()
+        viewModel.decrement()
+        assertEquals(-1, viewModel.count.value)
+    }
+
+    @Test
+    fun multipleOperations_calculateCorrectly() {
+        val viewModel = CounterViewModel()
+        viewModel.increment()
+        viewModel.increment()
+        viewModel.decrement()
+        viewModel.increment()
+        assertEquals(2, viewModel.count.value)
+    }
+}
